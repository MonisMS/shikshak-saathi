generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Enums ─────────────
enum Language {
  hi
  en
}

enum KitStatus {
  DRAFT
  GENERATING
  READY
  FAILED
}

enum SectionType {
  OBJECTIVES // learning outcomes + prior knowledge + keywords + expected misconceptions
  LESSON_PLAN // timed learning cycles (starter, explain, activity, practice, exit)
  BLACKBOARD // blackboard layout / low-resource visual (optional)
  MULTIGRADE // per-grade tasks for multi-grade rooms (optional)
  WORKSHEET // questions + answer key (same object → cannot disagree)
  EXIT_QUIZ // formative exit quiz: MCQ, each wrong option tagged with a misconception
  STARTER_QUIZ // prior-knowledge check quiz (optional)
  SUMMATIVE // end-of-chapter test / blueprint (optional)
  REMEDIAL // generic remedial activities (optional)
  PARENT_NOTE // homework summary for parents (optional)
}

enum SectionStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum RevisionSource {
  AI
  TEACHER
}

enum ResultMethod {
  TALLY
  PER_STUDENT
  CARD_SCAN
  OMR
}

enum SubmissionSource {
  ONLINE // student attempted via the /t/[token] link
  SCAN // teacher printed the sheet, students filled it on paper, teacher uploaded a photo and it was OCR'd
}

enum MisconceptionStatus {
  OPEN
  FIX_PLANNED
  RESOLVED
}

enum FixStatus {
  SUGGESTED
  ADDED
  DONE
  SKIPPED
}

enum ActivityType {
  SIGNED_UP
  KIT_CREATED
  SECTION_GENERATED
  SECTION_REGENERATED
  SECTION_EDITED
  KIT_EXPORTED_PDF
  KIT_EXPORTED_DOCX
  QUIZ_RESULTS_RECORDED
  FIX_ADDED
  PARENT_NOTE_SHARED
  VOICE_USED
}

// ───────────── Better Auth (generated by `npx auth generate`) ─────────────
// "Teacher" = User. Extra fields added via additionalFields in lib/auth.ts.
model User {
  id                   String   @id
  name                 String
  email                String   @unique
  emailVerified        Boolean  @default(false)
  image                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  school               String?
  district             String?
  preferredLanguage    String?  @default("hi")
  schoolType           String?
  uiLanguage           String?  @default("en")
  defaultPeriodMinutes Int?     @default(40)
  lowResourceDefault   Boolean? @default(true)
  onboarded            Boolean? @default(false)

  sessions         Session[]
  accounts         Account[]
  classrooms       Classroom[]
  kits             LessonKit[]
  activityLogs     ActivityLog[]
  uploadedChapters Chapter[]          @relation("ChapterUploader")
  generationLogs   GenerationLog[]
  classNotes       ClassNote[]
  testPublications TestPublication[]
  resources        TeachingResource[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ───────────── Domain ─────────────

/// A class the teacher teaches. Multi-grade rooms have several grades.
model Classroom {
  id           String   @id @default(cuid())
  teacherId    String
  teacher      User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name         String // "Class 3–5 (combined)", "7-B Science"
  subject      String // "Science", "Mathematics", "Hindi"
  grades       Int[] // [7] or [3,4,5]
  section      String?
  isMultiGrade Boolean  @default(false)
  studentCount Int      @default(30)
  language     Language @default(hi) // medium of instruction
  lowResource  Boolean  @default(true) // blackboard-only, no projector
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  students     Student[]
  kits         LessonKit[]
  quizSessions QuizSession[]

  @@index([teacherId])
}

/// Optional roster (roll numbers only — no student names needed; privacy).
model Student {
  id          String            @id @default(cuid())
  classroomId String
  classroom   Classroom         @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  rollNo      Int
  grade       Int? // for multi-grade rooms
  displayName String? // optional, never sent to the AI
  responses   StudentResponse[]

  @@unique([classroomId, rollNo])
}

/// NCERT chapter in the shared library ("defined educational content source").
/// id is a slug for seeded chapters (e.g. "c7-sci-02"); uploads use cuid() in code.
model Chapter {
  id           String   @id
  grade        Int // 1..12
  subject      String
  bookName     String // "Curiosity (Science, Class 7)"
  chapterNo    Int
  titleEn      String
  titleHi      String?
  sourceUrlEn  String // ncert.nic.in PDF link (shown as citation)
  sourceUrlHi  String?
  pageStart    Int // printed page number of first page
  pagesEn      Json // [{ page: 34, text: "..." }, ...] — page-tagged text
  pagesHi      Json?
  summary      String? // short cached summary for the library card
  isSeeded     Boolean  @default(true) // false = uploaded by a teacher
  uploadedById String?
  uploadedBy   User?    @relation("ChapterUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  kits LessonKit[]

  @@index([grade, subject])
}

/// One generated teaching kit for one chapter (+ optional classroom).
model LessonKit {
  id            String      @id @default(cuid())
  teacherId     String
  teacher       User        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classroomId   String?
  classroom     Classroom?  @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  chapterId     String?
  chapter       Chapter?    @relation(fields: [chapterId], references: [id])
  title         String // "Class 7 Science Ch 3 — Heat (Day 1)"
  language      Language
  status        KitStatus   @default(DRAFT)
  periodMinutes Int         @default(40)
  dayNumber     Int         @default(1) // day 2 kit carries yesterday's fixes
  lowResource   Boolean     @default(true)
  targetGrades  Int[] // multi-grade targets
  topic         String? // optional sub-topic / learning objective input
  teacherNote   String?
  pageFrom      Int?
  pageTo        Int?
  classSize     Int         @default(40)
  options       Json? // { sections, difficulty, localContext }
  scheduledFor  DateTime?
  diksha        Json?
  version       Int         @default(1)
  validation    Json? // last checker result: [{rule, pass, detail}]
  basedOnKitId  String? // previous day's kit whose quiz produced fixes
  basedOnKit    LessonKit?  @relation("KitChain", fields: [basedOnKitId], references: [id], onDelete: SetNull)
  nextKits      LessonKit[] @relation("KitChain")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  sections         KitSection[]
  quizSessions     QuizSession[]
  misconceptions   Misconception[]
  fixesIncluded    FixActivity[]     @relation("FixTargetKit")
  parentNotes      ParentNote[]
  generationLogs   GenerationLog[]
  testPublications TestPublication[]

  @@index([teacherId, createdAt])
  @@index([chapterId])
  @@index([classroomId, scheduledFor])
}

/// One section of a kit. Regenerating = new revision, same row.
model KitSection {
  id              String            @id @default(cuid())
  kitId           String
  kit             LessonKit         @relation(fields: [kitId], references: [id], onDelete: Cascade)
  type            SectionType
  status          SectionStatus     @default(PENDING)
  content         Json? // validated against zod schema for `type`
  version         Int               @default(0)
  editedByTeacher Boolean           @default(false)
  error           String?
  updatedAt       DateTime          @updatedAt
  revisions       SectionRevision[]

  @@unique([kitId, type])
}

/// History for undo / "compare with previous" (and proves "teacher stays in control").
model SectionRevision {
  id          String         @id @default(cuid())
  sectionId   String
  section     KitSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  version     Int
  content     Json
  source      RevisionSource
  instruction String? // "make it easier", "add a local example"
  createdAt   DateTime       @default(now())

  @@unique([sectionId, version])
}

/// One sitting of the formative quiz in class.
model QuizSession {
  id              String            @id @default(cuid())
  kitId           String
  kit             LessonKit         @relation(fields: [kitId], references: [id], onDelete: Cascade)
  classroomId     String?
  classroom       Classroom?        @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  method          ResultMethod      @default(TALLY)
  studentsPresent Int
  takenAt         DateTime          @default(now())
  tallies         QuestionTally[]
  responses       StudentResponse[]
  misconceptions  Misconception[]

  @@index([kitId])
}

/// Class-level: how many students chose each option. Minimum input path.
model QuestionTally {
  id         String      @id @default(cuid())
  sessionId  String
  session    QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId String // id inside QUIZ section JSON, e.g. "q2"
  optionKey  String // "A" | "B" | "C" | "D"
  count      Int
  isCorrect  Boolean

  @@unique([sessionId, questionId, optionKey])
}

/// Optional per-student answers (card scan / OMR / manual grid).
model StudentResponse {
  id         String      @id @default(cuid())
  sessionId  String
  session    QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId  String?
  student    Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  rollNo     Int
  questionId String
  optionKey  String
  isCorrect  Boolean

  @@unique([sessionId, rollNo, questionId])
  @@index([studentId])
}

/// A misconception found (from quiz distractors) for a kit.
model Misconception {
  id           String              @id @default(cuid())
  kitId        String
  kit          LessonKit           @relation(fields: [kitId], references: [id], onDelete: Cascade)
  sessionId    String?
  session      QuizSession?        @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  code         String // stable key from QUIZ JSON, e.g. "M2"
  label        String // "Thinks heat and temperature are the same"
  description  String?
  correction   String?
  questionIds  String[]
  studentCount Int
  percent      Float // studentCount / studentsPresent
  rollNos      Int[] // if per-student data exists → small groups
  status       MisconceptionStatus @default(OPEN)
  createdAt    DateTime            @default(now())
  fixes        FixActivity[]

  @@index([kitId, percent])
}

/// 5-minute fix for tomorrow, attached to the next kit.
model FixActivity {
  id              String        @id @default(cuid())
  misconceptionId String
  misconception   Misconception @relation(fields: [misconceptionId], references: [id], onDelete: Cascade)
  targetKitId     String? // next day's kit where it is inserted at the top
  targetKit       LessonKit?    @relation("FixTargetKit", fields: [targetKitId], references: [id], onDelete: SetNull)
  title           String
  minutes         Int           @default(5)
  steps           Json // ["Draw two cups on the board...", ...]
  materials       Json // ["chalk", "2 steel glasses", "warm water"]
  checkQuestion   String // 1 re-check MCQ to confirm the fix worked
  language        Language
  status          FixStatus     @default(SUGGESTED)
  createdAt       DateTime      @default(now())

  @@index([targetKitId])
}

/// Parent homework summary — public read-only page via share token.
model ParentNote {
  id           String    @id @default(cuid())
  kitId        String
  kit          LessonKit @relation(fields: [kitId], references: [id], onDelete: Cascade)
  language     Language
  content      Json // zod ParentNote object: { learnedToday, homework, homeActivity, askYourChild[] }
  whatsappText String // pre-formatted plain text for wa.me link
  shareToken   String    @unique // nanoid(12)
  views        Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([kitId])
}

/// A WORKSHEET or quiz section published for students to attempt via a public link/QR.
/// One kit section can have several publications over time (e.g. republished with new
/// instructions) — only `isOpen` ones accept new submissions.
model TestPublication {
  id                  String      @id @default(cuid())
  kitId               String
  kit                 LessonKit   @relation(fields: [kitId], references: [id], onDelete: Cascade)
  teacherId           String
  teacher             User        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  sectionType         SectionType // WORKSHEET | EXIT_QUIZ | STARTER_QUIZ
  token               String      @unique // nanoid(12), public URL /t/[token]
  isOpen              Boolean     @default(true)
  gradingInstructions String? // teacher's extra instructions for AI grading of open-ended answers
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  submissions TestSubmission[]

  @@index([kitId])
  @@index([teacherId])
}

/// One student's attempt. Deterministic question types (mcq/true_false/fill_blank/match,
/// and all quiz options) are auto-scored on submit; open-ended types (short_answer,
/// long_answer, case_based, assertion_reason) sit ungraded until the teacher runs
/// "Evaluate with AI".
model TestSubmission {
  id            String           @id @default(cuid())
  publicationId String
  publication   TestPublication  @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  studentName   String
  source        SubmissionSource @default(ONLINE)
  answers       Json // { [questionId]: string }
  perQuestion   Json? // { [questionId]: { marks: number|null, max: number, method: "auto"|"ai", feedback?: string } }
  autoMarks     Float            @default(0)
  aiMarks       Float?
  maxMarks      Float            @default(0)
  evaluatedAt   DateTime?
  submittedAt   DateTime         @default(now())

  @@index([publicationId])
}

/// Everything the dashboard counts.
model ActivityLog {
  id                   String       @id @default(cuid())
  teacherId            String
  teacher              User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  type                 ActivityType
  kitId                String?
  meta                 Json?
  minutesSavedEstimate Int          @default(0) // e.g. kit=60, worksheet=20, quiz=15
  createdAt            DateTime     @default(now())

  @@index([teacherId, createdAt])
  @@index([teacherId, type])
}

/// Every AI call: rate limiting per teacher + "< ₹1 per kit" cost claim + debugging.
model GenerationLog {
  id           String       @id @default(cuid())
  teacherId    String
  teacher      User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  kitId        String?
  kit          LessonKit?   @relation(fields: [kitId], references: [id], onDelete: SetNull)
  sectionType  SectionType?
  model        String
  inputTokens  Int?
  outputTokens Int?
  latencyMs    Int
  ok           Boolean
  error        String?
  fromCache    Boolean      @default(false)
  createdAt    DateTime     @default(now())

  @@index([teacherId, createdAt])
}

/// Wispr-style class/meeting note: audio (or pasted text) → transcript → AI summary.
model ClassNote {
  id              String   @id @default(cuid())
  teacherId       String
  teacher         User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title           String
  source          String // "record" | "upload" | "text"
  audioSeconds    Int?
  summaryLanguage String   @default("auto") // "auto" | "hi" | "en"
  transcript      String
  summary         Json? // zod NoteSummary: { title, overview, sections[{heading, bullets[]}], actionItems[] }
  summaryError    String?
  myNotes         String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([teacherId, createdAt])
}

model TeachingResource {
  id           String   @id @default(cuid())
  teacherId    String
  teacher      User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  kind         String // "pdf" | "doc" | "image" | "text" | "audio" — audio = class recording
  title        String
  grade        Int?
  subject      String?
  sourceUrl    String? // NCERT PDF link or recording URL
  fileName     String?
  audioSeconds Int?
  pages        Json // [{ page, text, source? }] — extracted text or transcript
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([teacherId, kind, createdAt])
}
